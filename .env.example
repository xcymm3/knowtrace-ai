# Public settings. Only NEXT_PUBLIC_* variables are exposed to the browser.
NEXT_PUBLIC_APP_NAME="CommerceLens AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# MVP persistence. Use the Supabase PostgreSQL connection string; pgvector is
# enabled in the same database. Do not expose the service-role key to the browser.
# Example format: postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="research-assets"
DOCUMENT_MAX_UPLOAD_SIZE_BYTES="52428800"

# The FastAPI worker uses Redis for background parsing, embedding and reporting jobs.
REDIS_URL="redis://localhost:6379"

# Server-only, OpenAI-compatible embeddings endpoint used to index and retrieve
# product/competitor/brand research. This project does not require an image API.
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1536"

# Server-only DeepSeek news Agent. It runs only when the test button or the scheduled task is triggered.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"
# Optional cost estimate for the observability dashboard. Enter the current
# billed RMB price per one million input/output tokens for the chosen model.
AGENT_INPUT_TOKEN_COST_CNY_PER_MILLION=""
AGENT_OUTPUT_TOKEN_COST_CNY_PER_MILLION=""

# Server-only AI follow-up chat. This is intentionally separate from the DeepSeek news Agent.
# Use an OpenAI-compatible endpoint for the provider associated with LLM_API_KEY.
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""
# Optional HTTP(S) proxy for the server-side AI follow-up request, for example http://127.0.0.1:7897.
LLM_PROXY_URL=""
AGENT_DIGEST_TTL_SECONDS="1800"

# Server-only news ingestion. The default uses multiple Chinese-language RSS feeds.
# Set NEWS_SOURCE_PROVIDER="un-news-rss" for only UN News, or "gdelt-doc" for GDELT DOC.
# These values are optional; defaults are applied when left blank.
NEWS_SOURCE_API_KEY=""
NEWS_SOURCE_PROVIDER="multi-rss-zh"
NEWS_SOURCE_QUERY=""
NEWS_SOURCE_TIMESPAN="24h"
NEWS_SOURCE_MAX_RECORDS="25"
NEWS_SOURCE_MAX_AGE_HOURS="72"

# Server-only full-web search contract. Leave WEB_SEARCH_PROVIDER blank until
# a provider adapter is enabled in the next implementation step.
# Runtime provider IDs: bocha, tavily. Other contract IDs (brave, serper,
# custom) are reserved until their adapters are added.
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_API_KEY=""
WEB_SEARCH_BASE_URL=""
# disabled: skip the scheduled digest; full: enable the daily Vercel Cron.
WEB_SEARCH_ROLLOUT="full"
WEB_SEARCH_MAX_RESULTS="12"
WEB_SEARCH_MAX_AGE_HOURS="72"
# Optional comma-separated domain suffixes. When blank, all public HTTP(S)
# search results are eligible; excluded domains always take precedence.
WEB_SEARCH_ALLOWED_DOMAINS=""
WEB_SEARCH_EXCLUDED_DOMAINS=""

# Server-only security and observability settings.
CRON_SECRET=""
SESSION_SECRET=""
SENTRY_DSN=""
