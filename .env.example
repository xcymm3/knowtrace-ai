# Public settings. Only NEXT_PUBLIC_* variables are exposed to the browser.
NEXT_PUBLIC_APP_NAME="KnowTrace AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Docker Compose defaults to 3001 so it can run beside `pnpm dev` on 3000.
# Set WEB_PORT="3000" when the local development server is stopped.
WEB_PORT="3001"
# 本机开发时供 Next.js 的同域 API 代理使用；Docker Compose 内部会自动改用 http://api:8000。
# Vercel 部署不需要设置此项。
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
API_PROXY_TARGET="http://localhost:8000"
# Comma-separated browser origins accepted by FastAPI. Add the deployed web URL
# when API and frontend run on different hosts.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# MVP persistence. Use the Supabase PostgreSQL connection string; pgvector is
# enabled in the same database. Do not expose the service-role key to the browser.
# Example format: postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="knowtrace-assets"
DOCUMENT_MAX_UPLOAD_SIZE_BYTES="52428800"
DOCUMENT_MAX_EXTRACTED_CHARACTERS="1000000"

# The FastAPI worker uses Redis for background parsing, embedding and reporting jobs.
REDIS_URL="redis://localhost:6379"
# auto: Vercel runs short tasks in the upload request; Docker uses the Worker.
# Set queue or inline only when an environment needs an explicit override.
TASK_EXECUTION_MODE="auto"

# Server-only, OpenAI-compatible embeddings endpoint used to index and retrieve
# documents inside a KnowTrace project. This project does not require an image API.
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1536"

# Server-only chat model settings used by the LangChain adapter. An OpenAI key
# may be reused when the provider supports both embedding and chat endpoints.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4.1-mini"
LLM_TEMPERATURE="0"
